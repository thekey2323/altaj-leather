# ==============================================================================
# KHEDMA AI — PRODUCTION SAAS ENVIRONMENT VARIABLES & INTEGRATIONS
# ==============================================================================
# Duplicate this file as .env.local to configure your live credentials.

# 1. AI ENGINE (CV Parsing, ATS Scoring, CV Optimization, Cover Letters)
# Get your Google Gemini API key (Free & High Speed) from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_google_gemini_api_key_here

# Alternatively, if you prefer OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# 2. DATABASE, AUTHENTICATION & DOCUMENT STORAGE (Recommended: Supabase)
# Create a free project at: https://supabase.com
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_public_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key_here
NEXT_PUBLIC_CV_STORAGE_BUCKET=candidate-resumes

# 3. LIVE MOROCCAN JOB MARKET AGGREGATION
# RapidAPI JSearch / SerpAPI Google Jobs Morocco
RAPIDAPI_KEY=your_rapidapi_key_here
SERPAPI_API_KEY=your_serpapi_key_here

# 4. PAYMENT GATEWAY (Moroccan Dirham MAD & International Cards)
# Option A: YouCan Pay (Moroccan gateway supporting Moroccan bank cards)
YOUCAN_PAY_PUBLIC_KEY=pub_your_youcanpay_key
YOUCAN_PAY_PRIVATE_KEY=pri_your_youcanpay_secret

# Option B: Stripe (International & Moroccan cards with dotation e-commerce)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_key
STRIPE_SECRET_KEY=sk_test_your_key

# 5. TRANSACTIONAL EMAIL & ALERTS
# Resend (https://resend.com)
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM=notifications@khedma.ma

# 6. APP URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
